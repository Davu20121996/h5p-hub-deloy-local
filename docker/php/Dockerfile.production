FROM php:8.3-fpm-bookworm AS php-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev libzip-dev libicu-dev unzip git \
    && docker-php-ext-install pdo_pgsql zip intl opcache pcntl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
ENV APP_ENV=production APP_DEBUG=false
COPY docker/php/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY docker/php/opcache.production.ini /usr/local/etc/php/conf.d/opcache.ini
COPY docker/php/www.conf /usr/local/etc/php-fpm.d/www.conf
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-autoloader
COPY . .
RUN mkdir -p storage/app/private storage/app/public storage/framework/views \
        storage/framework/cache/data storage/framework/sessions storage/logs bootstrap/cache \
    && composer dump-autoload --no-dev --optimize \
    && chown -R www-data:www-data storage bootstrap/cache

FROM node:22-bookworm-slim AS assets
WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
COPY --from=php-build /var/www/html/vendor ./vendor
RUN npm run build

FROM php-build AS production
COPY --from=assets /work/public/build ./public/build
COPY docker/php/production-init.sh /usr/local/bin/production-init.sh
COPY docker/php/production-bootstrap.php /usr/local/bin/production-bootstrap.php
RUN touch /var/log/php-fpm-slow.log && chown www-data:www-data /var/log/php-fpm-slow.log
USER www-data
CMD ["php-fpm"]

FROM nginx:1.28-alpine AS web
COPY --from=production /var/www/html/public /var/www/html/public
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
